{
  "name": "qui-diogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "reset": "node database/reset.js",
    "db:start": "powershell -ExecutionPolicy Bypass -File tools/pg-local.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File tools/pg-local.ps1 stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File tools/pg-local.ps1 status",
    "db:reset": "powershell -ExecutionPolicy Bypass -File tools/pg-local.ps1 reset"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "pg": "^8.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

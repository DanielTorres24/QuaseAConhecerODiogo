# Instala sempre as devDependencies, mesmo com NODE_ENV=production.
#
# O build precisa do typescript e dos @types para a verificacao de tipos do
# "next build". Como o servico no Render corre com NODE_ENV=production, um
# "npm install" simples omitia-as e o build falhava com:
#
#   It looks like you're trying to use TypeScript but do not have the
#   required package(s) installed.
#
# Ficar aqui, e nao apenas no buildCommand do render.yaml, e de proposito:
# assim vale para qualquer comando de build, incluindo o que ja esteja
# gravado no dashboard do Render e que nao volta a ser lido do render.yaml.
include=dev
